# Server Configuration
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/groupbuy

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Encryption Keys (generate with: openssl rand -hex 32)
ENCRYPTION_MASTER_KEY=your-32-byte-hex-encryption-key
ACCESS_CODE_SALT=your-random-access-code-salt

# Frontend URL (for CORS and redirects)
FRONTEND_URL=http://localhost:3000

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Razorpay Configuration
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Email Configuration (optional)
SENDGRID_API_KEY=SG.your_sendgrid_api_key
