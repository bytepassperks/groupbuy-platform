{
  "manifest_version": 3,
  "name": "GroupBuy Auto-Login",
  "version": "1.0.0",
  "description": "Securely access your GroupBuy subscriptions with automatic login",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*.semrush.com/*",
    "https://*.ahrefs.com/*",
    "https://*.canva.com/*",
    "https://*.netflix.com/*",
    "https://*.grammarly.com/*",
    "https://*.envato.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.semrush.com/*",
        "https://*.ahrefs.com/*",
        "https://*.canva.com/*",
        "https://*.netflix.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
